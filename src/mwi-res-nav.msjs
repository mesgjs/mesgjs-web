[(
modpath='mwi/mwi-res-nav'
version='1.0.0'
featreq='mwi.compRegOpen'
featpro='mwi.comp.MWIResNav'
modcaps=''
)]

/*
 * MWIResNav - MWI Responsive Navigation and related components
 * Copyright 2026 by Kappa Computer Solutions, LLC and Brian Katzung
 *
 * [resNav] Responsive navigation
 * [subMenu] Sub menu
 * [megaMenu] Mega menu
 */

@c(if @c(not @mid) { @c(throw 'MWIResNav requires Mesgjs module management to be active')})
#(nset
	REG_OPEN_FT=mwi.compRegOpen
	REG_IF=MWIRegistry

	READY_FT=mwi.comp.MWIResNav
	NAV=resNav
	SUB=subMenu
	MEGA=megaMenu
)
@c(await @c(fwait #REG_OPEN_FT) {
	#(nset registry=@c(get #REG_IF))

	#registry(register #NAV [tpl=[
		[h.div m.percl='@@'
			// portrait-mode nav-rail opener
			[h.details [h.summary]]
			[h.div m.percl=left [m.slot name=c.left]]  // left-of-nav (e.g. branding)
			[h.nav m.coat=[navDet.name='<name|_M_navDet>']
				[h.div [m.slot]]          // main nav menu
			]
			[h.div [m.slot name=c.right]] // right-of-nav (e.g. profile menu)
	]] scopedCSS="
html { container-name: root; --resnav-mode: landscape; }
@media (orientation: portrait) and (width < 800px) { html { --resnav-mode: portrait; } }
.@@ {
	display: flex; gap: 10px 20px;
	position: relative;
	> * { flex-grow: 0; }
	> nav {
		display: inline-block; flex-grow: 1;
		summary {
			list-style: none; cursor: pointer;
			&::after { /* down (to open) */
				display: inline-block; width: 1.5rem; text-align: right;
				height: 1rem; line-height: 1rem; vertical-align: middle;
				content: '\25BD';
			}
		}
		details[open] > summary::after { content: '\25B2'; } /* up (to close) */
	}
}
@container root style(--resnav-mode: landscape) { .@@ {
	z-index: 9999;
	.nav-mode::after { content: ' landscape'; }
	> details { display: none; }
	nav { flex-grow: 1; }
	nav > div {
		display: flex; flex-wrap: wrap; gap: 10px 20px;
		> * { z-index: 2; }
		> details[open] {
			z-index: auto;
			> summary { /* click-out to summary */
				z-index: 1;
				&::before { position: fixed; inset: 0; content: ''; }
			}
			> div { z-index: 2; }
		}
	}
	nav details {
		&.megamenu > div { display: contents; }
		&.submenu > div {
			display: flex; flex-wrap: wrap; gap: 10px 20px;
		}
		&.submenu > div, &.megamenu > div > div { /* sub-menu trays */
			position: absolute; top: calc(100% + 10px); left: 0; right: 0;
			:is(.submenu *, .megamenu *) { left: -1px; right: -1px; }
			padding: 5px; border: solid 1px #000; border-radius: 3px;
			background-color: #eee; /* TEMPORARY */
		}
	}
}}
@container root style(--resnav-mode: portrait) { .@@ {
	.nav-mode::after { content: ' portrait'; }
	> details {
		display: inline-block; /* for descendant z */
		summary { list-style: none; }
		summary::after {
			display: inline-block;
			box-sizing: border-box; width: 24px; height: 24px;
			font-family: sans-serif; font-size: 24px; line-height: 24px;
			text-align: center; vertical-align: middle;
			border: solid 1px #000; border-radius: 3px;
			background-color: #eee; content: '\2261';
		}
		&:is([open]) {
			summary::before { /* click-out backdrop below rail */
				position: fixed; inset: 0; content: ''; z-index: 9985;
				background-color: rgba(0, 0, 0, 0.2); /* TEMP */
			}
			summary::after { /* closer above rail */
				position: absolute; top: 6px; left: 6px; z-index: 9995;
				font-size: 16px; content: '\25C0';
			}
		}
	}
	&:has(> details:not([open])) > nav { display: none; } /* nav rail closed */
	> div.left { flex-grow: 1; }
	> nav {
		position: absolute; top: 0; left: 0; height: 100dvh;
		box-sizing: border-box; border: solid 1px #000;
		border-left: none; border-radius: 0 10px 10px 0;
		padding: 35px 0 10px 5px; z-index: 9990;
		background-color: #eee; /* TEMPORARY */
		&:has(details[open].megamenu:not(details:not([open]) *)) { right: 0; }
		> div { /* left rail */
			width: max-content; min-width: 100px; padding-right: 5px;
			height: calc(100dvh - 47px); overflow-y: auto;
			display: flex; flex-direction: column; gap: 0.5rem;
			anchor-name: --rail;
		}
		details { margin-left: 1em; }
		summary { margin-left: -1em; }
		details.megamenu:not(.megamenu .megamenu) > summary::after { content: '\25B7'; }
		details[open].megamenu:not(.megamenu .megamenu) > summary::after { content: '\25C0'; }
		details[open].megamenu:not(.megamenu .megamenu) > div {
			/* outline-to-tray-stack transition */
			position: absolute; overflow-y: auto;
			top: 36px; right: 5px; bottom: 10px;
			left: calc(anchor(--rail right) + 5px);
			border-left: 1px solid #000;
			details.submenu > div {
				display: flex; flex-wrap: wrap; gap: 10px 20px;
			}
		}
		details:not(.megamenu, .megamenu *) > div {
			display: flex; flex-direction: column;
			padding-top: 10px; gap: 10px;
		}
		.megamenu details.submenu > div, details.megamenu > div > div {
			padding: 5px; box-sizing: border-box;
			border: solid 1px #000; border-radius: 3px;
			position: absolute; left: 10px; right: 5px;
		}
		.megamenu details.submenu > div, .megamenu details.megamenu > div > div {
			left: -1px; right: -1px;
			top: calc(100% + 10px); /* post-transition sub-tray position */
		}
	}
}}
"])

	#registry(register #SUB [tpl=[
		[h.details
			m.percl=submenu
			m.coat=[navDet.name='<a:navDet.name>-lvl' name='<A:navDet.name>']
			[h.summary [m.slot name=c.label]]
			[h.div [m.slot]]
		]
	]])

	#registry(register #MEGA [tpl=[
		[h.details
			m.percl=megamenu
			m.coat=[navDet.name='<a:navDet.name>-lvl' name='<A:navDet.name>']
			[h.summary [m.slot name=c.label]]
			[h.div [h.div [m.slot]]]
		]
	]])

	@c(fready #READY_FT)
})
