[(
featreq='MWIDocument mwi.comp.MWIAggrScript mwi.comp.MWIResNav mwi.comp.MWIBackToTop'
)]
@c(fwait
	MWIDocument
	mwi.comp.MWIAggrScript
	mwi.comp.MWIBackToTop
	mwi.comp.MWIResNav
)(then {
	#(nset doc=@c(get MWIDocument))
	#doc(append list=[
		[h.doctype]
		[h.head
			[m.scpcss]
			[h.style m.text='
				html[data-mode="landscape"] { --resnav-mode: landscape; }
				html[data-mode="portrait"] { --resnav-mode: portrait; }
				body {
					margin: 0; padding: 1px;
					font-family: sans-serif;
				}
				summary { cursor: pointer; }
			']
			[m.script from=head]
		]
		[h.body
			[h.p 'Mode: '
				[h.label [h.input type=radio name=mode onclick='javascript:document.documentElement.dataset.mode = "";' checked=''] ' Auto ']
				[h.label [h.input type=radio name=mode onclick='javascript:document.documentElement.dataset.mode = "landscape";'] ' Landscape ']
				[h.label [h.input type=radio name=mode onclick='javascript:document.documentElement.dataset.mode = "portrait";'] ' Portrait']
			]
			[h.p 'Before header']
			[h.header [resNav c.left=[[h.span class=nav-mode left]]
				[h.a href='https://example.com' 'Example A']
				[subMenu c.label=['Sub-menu level 1']
					[h.a href='https://example.com' 'Example 1A']
					[subMenu c.label=['Sub-menu level 2']
						[h.a href='https://example.com' 'Example 2A']
					]
					[subMenu c.label=['Alt level 2']
						[h.a href='https://example.com' 'Alt 2A']
					]
					[megaMenu c.label=['Mega menu']
						[h.p 'Mega menu content']
						[subMenu c.label=['Mega sub-menu']
							[h.a href='https://example.com' 'Mega Sub 1']
							[h.a href='https://example.com' 'Mega Sub 2']
							[h.a href='https://example.com' 'Mega Sub 3']
						]
						[h.p 'Mega menu content']
					]
					[h.a href='https://example.com' 'Example 1B']
				]
				[h.a href='https://example.com' 'Example B']
				c.right=[[h.span right]]
			]]
			[h.p 'After header']
			[h.p style='margin-top: 110dvh;' 'Below the fold']
			[h.p style='margin-top: 90dvh;' 'End of page']
			[backToTop]
		]
	])
	// @c(log HTML:)
	@c(log #doc(getHTML))
	/*
	@c(log SPEC:)
	@c(log #doc(root)(getSpec)(toSLID))
	*/
})
